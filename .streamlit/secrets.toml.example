# Copy to .streamlit/secrets.toml (never commit the real file) or paste into the Streamlit Cloud "Secrets" box.
# Every key can also be given as an environment variable OCULENS_<KEY> (for example OCULENS_DEMO_MODE=0).

demo_mode = "0"                       # "1" = demo doctors, patients and cases with the published demo passwords
admin_password = "choose-a-long-one"  # first 'admin' account (production); must be changed at first sign-in
org_name = "Your Eye Clinic"
org_tagline = "Anterior-eye screening and referral"
support_phone = "+91 ..."
support_email = "help@your-clinic.example"
session_timeout_min = "30"
max_login_attempts = "5"
lockout_min = "15"
# data_dir = "/data"                  # where the database, photos and logs are kept

# Optional: online AI assistant (Claude). Without it the assistant runs offline.
# ANTHROPIC_API_KEY = "..."
